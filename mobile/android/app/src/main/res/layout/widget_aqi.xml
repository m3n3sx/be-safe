<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aqi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_status_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌫 JAKOŚĆ POWIETRZA"
            android:textColor="#9AA7B2"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/aqi_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/widget_dot" />
    </LinearLayout>

    <TextView
        android:id="@+id/aqi_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Brak danych"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/aqi_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Otwórz aplikację po dane"
        android:textColor="#9AA7B2"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
