<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/near_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_status_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 NAJBLIŻSZY ALERT"
        android:textColor="#9AA7B2"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/near_cat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Brak zagrożeń"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/near_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Twoja okolica jest bezpieczna"
        android:textColor="#9AA7B2"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
