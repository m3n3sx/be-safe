PORT=3000
DATABASE_URL=postgresql://alertmap:password@localhost:5432/alertmap
JWT_SECRET=change-me-to-random-secret
JWT_EXPIRES_IN=7d
FCM_SERVER_KEY=your-firebase-server-key

# Google Sign-In (POST /auth/google) — dozwolone audience ID tokena, po przecinku.
# Domyślnie (puste) web client be:Safe: 1098119585965-1dmn79cgjbhsr84f1iu3dibvpilc906p.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
# TYLKO tymczasowo na czas wymiany apki: true = akceptuj stare klienty wysyłające sam email (bez id_token).
# Niebezpieczne (logowanie na dowolny email). Domyślnie false.
GOOGLE_AUTH_LEGACY_EMAIL_ONLY=false
